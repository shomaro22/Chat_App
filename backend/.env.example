DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatapp?sslmode=disable

# ローカル用テストログイン（`go run ./cmd/seedtestuser` の既定と揃えられる）
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=password123
# TEST_USER_NAME=Test
# SEED_TEST_USER_RESET=1   # seedtestuser 実行時に -reset と同じ（既存ユーザーのパスワード更新）
# SEED_TEST_USER_TEAM=1    # -team と同じ（alice / bob を追加）

# CORS: DATABASE_URL が localhost / 127.0.0.1 のとき、未設定なら Vite 用オリジンを自動許可する。
# 上書きする場合はカンマ区切り。無効化は CORS_DISABLE=1
# CORS_ALLOW_ORIGINS=https://app.example.com
# CORS_DISABLE=1

# Redis（レート制限）。REDIS_ADDR を空にすると Redis レート制限は無効（スキップ）。
# docker compose で Redis を起動したあと、ホストからバックエンドを動かす場合は localhost:6379。
# 同一 compose 内のコンテナから接続する場合は redis:6379。
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
